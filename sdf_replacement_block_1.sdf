    <!-- pine4: original pose 7.08738 1.33612 0 0 -0 0 -->
    <model name="pine4_fire">
      <pose>0 0 -30 0 0 0</pose>
      <static>true</static>
      <link name="flame">
        <visual name="flame_base">
          <pose>0 0 1.9 0 0 0</pose>
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material>
            <ambient>0.9 0.15 0.02 1</ambient>
            <diffuse>0.9 0.15 0.02 1</diffuse>
