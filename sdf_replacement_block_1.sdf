        </visual>
        <visual name="canopy_visual">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry>
            <sphere><radius>0.6</radius></sphere>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.18 0.18 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- End reusable burning-object additions -->
