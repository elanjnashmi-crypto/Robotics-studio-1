          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.15</radius><length>2.0</length></cylinder>
          </geometry>
        </collision>
        <collision name="canopy_collision">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry>
            <sphere><radius>0.6</radius></sphere>
          </geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.15</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
